@page "/Account/Lockout"

<PageTitle>账号已锁定 · KidPlan</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">🔒 账号已锁定</div>
        <p class="auth-sub">登录失败次数过多，账号被临时锁定，请稍后再试。</p>
        <a href="Account/Login" class="auth-btn" style="display:block;text-align:center;text-decoration:none">返回登录</a>
    </div>
</div>
