@page "/Account/ForgotPasswordConfirmation"

<PageTitle>重置邮件已发送 · KidPlan</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">🌱 KidPlan</div>
        <p class="auth-sub">请查收邮件</p>

        <div class="auth-alert auth-alert-success" role="alert">
            如果这个邮箱在 KidPlan 注册过，我们已经把重置密码的链接发过去了。<br />
            链接 24 小时内有效，点开后就能设置新密码。
        </div>

        <div class="auth-links">
            <div>没收到？看看垃圾邮件，或者 <a href="Account/ForgotPassword">再试一次</a></div>
            <div style="margin-top:6px"><a href="Account/Login">返回登录</a></div>
        </div>
    </div>
</div>
