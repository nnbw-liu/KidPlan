@page "/Account/ResetPasswordConfirmation"

<PageTitle>密码已重置 · KidPlan</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">🌱 KidPlan</div>
        <p class="auth-sub">密码已重置</p>

        <div class="auth-alert auth-alert-success" role="alert">
            新密码已经生效，现在可以用它登录了。
        </div>

        <a class="auth-btn auth-btn-link" href="Account/Login">去登录</a>
    </div>
</div>
