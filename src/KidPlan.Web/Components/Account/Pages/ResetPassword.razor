@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using KidPlan.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>设置新密码 · KidPlan</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">🌱 KidPlan</div>
        <p class="auth-sub">设置一个新密码</p>

        <StatusMessage Message="@errorMessage" />

        <EditForm Model="Input" method="post" OnValidSubmit="OnValidSubmitAsync" FormName="reset-password">
            <DataAnnotationsValidator />
            <ValidationSummary class="auth-validation-summary" role="alert" />

            @* 重置链接里的 code 在查询字符串上，表单 POST 时要带上，否则验证不过。 *@
            <input type="hidden" name="Input.Code" value="@Input.Code" />

            <div class="auth-field">
                <label for="Input.Email">你的邮箱</label>
                <InputText @bind-Value="Input.Email"
                           id="Input.Email"
                           class="auth-input"
                           autocomplete="username"
                           placeholder="you@example.com" />
                <ValidationMessage For="() => Input.Email" class="auth-error" />
            </div>

            <div class="auth-field">
                <label for="Input.Password">新密码</label>
                <InputText type="password"
                           @bind-Value="Input.Password"
                           id="Input.Password"
                           class="auth-input"
                           autocomplete="new-password"
                           placeholder="至少 6 位" />
                <ValidationMessage For="() => Input.Password" class="auth-error" />
            </div>

            <div class="auth-field">
                <label for="Input.ConfirmPassword">再输一次新密码</label>
                <InputText type="password"
                           @bind-Value="Input.ConfirmPassword"
                           id="Input.ConfirmPassword"
                           class="auth-input"
                           autocomplete="new-password"
                           placeholder="再输入一次" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="auth-error" />
            </div>

            <button type="submit" class="auth-btn">设置新密码</button>
        </EditForm>

        <div class="auth-links">
            <a href="Account/Login">返回登录</a>
        </div>
    </div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();

        // 首次打开（GET）时从查询字符串取 code；表单回发（POST）时 code 在表单里。
        if (string.IsNullOrEmpty(Input.Code))
        {
            Input.Code = Code;
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // 不暴露账号是否存在；直接给“已重置”的结果，反正也登不进去。
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code ?? string.Empty, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        errorMessage = "Error: " + (result.Errors.Any(e => e.Code == nameof(IdentityErrorDescriber.InvalidToken))
            ? "这个重置链接无效或已经过期，请重新申请一次。"
            : string.Join("；", result.Errors.Select(e => e.Description)));
    }

    private sealed class InputModel
    {
        public string? Code { get; set; }

        [Required(ErrorMessage = "请输入邮箱")]
        [EmailAddress(ErrorMessage = "邮箱格式不正确")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "请输入新密码")]
        [StringLength(100, ErrorMessage = "密码长度需要在 {2} 到 {1} 位之间", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "两次输入的密码不一致")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
