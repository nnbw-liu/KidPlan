# =============================================================================
# KidPlan 环境变量模板
#
# 使用方法：
#   1) 复制为 .env ：  cp .env.example .env
#   2) 修改下面所有 CHANGE_ME 的密码（建议 24 位以上的随机字符串）
#   3) 一键部署脚本会自动帮你在缺少 .env 时生成随机密码：
#        bash deploy/deploy.sh install
#
# ⚠️ 安全提醒：
#   - .env 里是数据库明文密码和邮箱授权码，**绝对不要提交到 Git**。
#     仓库根目录的 .gitignore / .dockerignore 已将其排除；提交前请再确认一次。
#   - MYSQL_* 密码里请避免使用 $ " ' ` \ @ : ; # 和空格，
#     因为 $ 会被 Compose 当作变量插值、: ; 会被 MySQL 连接串当作分隔符。
#     使用纯字母+数字最省事（部署脚本生成的随机密码就只含字母数字）。
#   - SMTP_USERNAME 是个邮箱地址，里面的 @ 没问题（它不参与连接串拼接）。
# =============================================================================

# --- MySQL 容器初始化参数（首次创建数据卷时生效）---

# MySQL root 密码（仅用于容器内管理/备份，不对外使用）
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# 业务数据库名，与连接串中的 Database 一致
MYSQL_DATABASE=kidplan

# 业务数据库账号名
MYSQL_USER=kidplan

# 业务数据库密码（应用通过它连接数据库）
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

# --- 邮件（SMTP）：注册要发确认邮件、忘记密码要发重置邮件 ---

# SMTP 服务器。QQ 邮箱：smtp.qq.com / 465 / SslOnConnect
# 163 邮箱：smtp.163.com / 465 / SslOnConnect
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=SslOnConnect

# SMTP 登录账号，通常就是完整邮箱地址
SMTP_USERNAME=CHANGE_ME@qq.com

# ⚠️ 这是邮箱的「SMTP 授权码」，不是邮箱登录密码！
# QQ 邮箱获取路径：设置 → 账户 → POP3/IMAP/SMTP 服务 → 开启并生成授权码
SMTP_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE

# 发件人地址。留空则使用 SMTP_USERNAME
SMTP_FROM_ADDRESS=

# 邮件里链接使用的对外地址，例如 https://kidplan.example.com
# 强烈建议填：宝塔 Nginx 若没有转发 X-Forwarded-Proto / X-Forwarded-Host，
# 确认邮箱 / 重置密码的链接会变成 http://容器内网地址，用户点开打不开。
PUBLIC_BASE_URL=

# --- 应用与宿主机参数 ---

# 应用在宿主机上的监听端口（只绑定 127.0.0.1，由宝塔 Nginx 反代）
# 若宝塔上该端口已被占用，改成 8081、9080 等空闲端口，然后重新 install/restart。
APP_PORT=8080

# 容器时区（饭点状态、每日统计等按本地时间判断，必须正确）
TZ=Asia/Shanghai
