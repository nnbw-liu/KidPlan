{
  // ===========================================================================
  // KidPlan 模型（AI）全局配置
  //
  // 这个文件是「全局一份」，所有账号共用；每个账号还可以在
  // 「模型设置 → 我的账号覆盖」里单独覆盖，覆盖内容存在数据库里，不写这个文件。
  //
  // 改完保存即可生效，**不需要重启服务**：
  // 应用自己盯着这个文件的变更（400ms 去抖），读成功就立刻换用新配置。
  // 万一 JSON 写坏了也不会把服务搞崩——它会继续用上一份能用的配置，
  // 并把错误显示在「模型设置」页顶部的提示条里。
  //
  // 也可以直接在「模型设置 → 全局配置」里改，界面保存后会重写本文件
  // （重写会丢掉下面这些注释，所以重要的备注建议写进 name 字段）。
  // ===========================================================================

  // 结构版本，暂时固定为 1。
  "version": 1,

  // 默认用哪个端点、哪个模型。留空也可以：保存时会被自动修正为第一个启用的端点。
  "defaultProviderId": null,
  "defaultModel": null,

  // 饮食推荐的默认参数（每个账号可以各自覆盖）。
  "recommendation": {
    // 前置周期最多 30 天。上限是硬编码的，改这里也不会超过 30。
    "maxLookbackDays": 30,
    "defaultLookbackDays": 7,
    // 0.4 偏保守：饮食安排要的是稳定可执行，不是花样多。
    "temperature": 0.4,
    "timeoutSeconds": 180,
    // 8192 是给「推理模型」留的余量：这类模型会先把额度花在思考过程上，
    // 给 2500 时实测会出现「token 全是 reasoning、正文是空的」，一次推荐直接失败
    // （页面上会告诉你「额度全花在推理上了」）。非推理模型给它也没有副作用，
    // 它只是天花板，模型不会主动写满。
    "maxOutputTokens": 8192
  },

  // ---------------------------------------------------------------------------
  // 模型端点列表（OpenAI 兼容：POST {baseUrl}/chat/completions、GET {baseUrl}/models）
  //
  // 每一项的字段：
  //   id           必填，唯一。改 id 等于新建一个端点。
  //   name         界面上显示的名字，随便写。
  //   baseUrl      必填。要写到版本号为止，不要再带 /chat/completions。
  //                例：https://api.deepseek.com/v1 、http://127.0.0.1:1234/v1
  //   apiKey       没有鉴权的本地模型可以省略或留空。
  //   enabled      停用后界面不再列出它。
  //   transport    Direct（默认，服务端自己发请求）
  //                LocalRelay（顺着客户端电脑挂上来的中继长连接发，见「本机中继」页）
  //   relayNodeId  transport 为 LocalRelay 时用哪个中继节点。留空 = 该账号下最近活跃的那个。
  //   models       模型名列表，可以手工往里加任意字符串，不要求能从接口拉取到。
  //   extraHeaders 需要额外请求头时用（例如某些中转站要 HTTP-Referer）。
  //
  // 下面的示例全被注释掉了，需要时把 // 去掉再改。
  // ---------------------------------------------------------------------------
  "providers": [
    // {
    //   "id": "deepseek",
    //   "name": "DeepSeek（云端，便宜）",
    //   "baseUrl": "https://api.deepseek.com/v1",
    //   "apiKey": "sk-在此填入你的密钥",
    //   "enabled": true,
    //   "transport": "Direct",
    //   "models": ["deepseek-chat"],
    //   "extraHeaders": {}
    // },
    // {
    //   "id": "home-pc",
    //   "name": "家里电脑上的本地模型（走中继）",
    //   "baseUrl": "http://127.0.0.1:1234/v1",
    //   "enabled": false,
    //   "transport": "LocalRelay",
    //   "relayNodeId": null,
    //   "models": ["qwen2.5-7b-instruct"],
    //   "extraHeaders": {}
    // }
  ]
}
